// Pokefolio staging bootstrap: DENY ALL until separate Firebase Auth,
// project identity and owner-scoped rules are independently configured in #2.
// This file is NOT deployed automatically and must not be applied to Vintage Binder.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
