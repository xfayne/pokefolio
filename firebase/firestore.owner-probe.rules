// Prototype for an isolated infrastructure probe; not application collection rules.
// Data model: stagingChecks/{uid}
// schemaVersion: 1; ownerUid: immutable path UID; message: string <= 120 chars;
// createdAt: immutable server timestamp; updatedAt: server timestamp.
// All collection, binder, Wishlist, shipment, sharing and analysis paths stay denied.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    function isValidProbe(data, uid) {
      return data.keys().hasAll(['schemaVersion', 'ownerUid', 'message', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['schemaVersion', 'ownerUid', 'message', 'createdAt', 'updatedAt'])
        && data.schemaVersion == 1
        && data.ownerUid is string && data.ownerUid == uid && data.ownerUid.size() <= 128
        && data.message is string && data.message.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }
    match /stagingChecks/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidProbe(request.resource.data, uid)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && isValidProbe(request.resource.data, uid)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
